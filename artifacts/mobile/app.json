{
  "expo": {
    "name": "YOU ALL",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youall",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/icon.png",
      "imageWidth": 180,
      "resizeMode": "contain",
      "backgroundColor": "#090909"
    },
    "ios": {
      "bundleIdentifier": "com.youall.social",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:ultimate-master-build--yitayal647.replit.app"
      ]
    },
    "android": {
      "package": "com.youall.social",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#090909"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ultimate-master-build--yitayal647.replit.app",
              "pathPrefix": "/api/share/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "YOU ALL needs access to the videos you choose to upload."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#090909"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
